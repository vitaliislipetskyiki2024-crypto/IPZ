<Window x:Class="CarServiceApp.CreateBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог послуг та Запис на ремонт" Height="580" Width="460"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <!-- Центральна біла картка створення запису -->
        <Border Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">

                    <!-- Іконка та заголовок -->
                    <TextBlock Text="🔧" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Запис на обслуговування" FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Вибір послуги -->
                    <TextBlock Text="Оберіть послугу з каталогу:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CbServices" Height="34" Margin="0,0,0,12" DisplayMemberPath="Title" 
                              Padding="8,4" VerticalContentAlignment="Center"/>

                    <!-- Модель авто -->
                    <TextBlock Text="Марка та модель авто:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCarModel" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,12"/>

                    <!-- Номер авто -->
                    <TextBlock Text="Державний номер авто:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCarNumber" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,12"/>

                    <!-- Дата візиту -->
                    <TextBlock Text="Бажана дата візиту:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpOrderDate" Height="34" Margin="0,0,0,12" 
                                Padding="8,4" VerticalContentAlignment="Center"/>

                    <!-- Коментар -->
                    <TextBlock Text="Опис проблеми / Коментар:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtComment" Height="60" Margin="0,0,0,18" Padding="8,5" 
                             TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1"/>

                    <!-- Кнопка підтвердження -->
                    <Button Content="Підтвердити запис" Style="{StaticResource PrimaryButtonStyle}" 
                            Background="#10B981" Padding="0,8" FontWeight="Bold" FontSize="14" 
                            Click="BtnSubmitOrder_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>