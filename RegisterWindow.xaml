<Window x:Class="CarServiceApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація клієнта — Автосервіс" Height="620" Width="440"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <!-- Центральна біла картка реєстрації -->
        <Border Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">

                    <!-- Іконка та заголовок -->
                    <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Реєстрація клієнта" FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Логін -->
                    <TextBlock Text="Логін:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtLogin" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,10"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="TxtPassword" Height="34" Padding="8,5" 
                                 Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                    <!-- ПІБ -->
                    <TextBlock Text="ПІБ клієнта:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,10"/>

                    <!-- Телефон -->
                    <TextBlock Text="Номер телефону:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtPhone" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,10"/>

                    <!-- Модель авто -->
                    <TextBlock Text="Марка та модель авто:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtCarModel" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,10"/>

                    <!-- Номер авто -->
                    <TextBlock Text="Держ. номер авто:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtCarNumber" Style="{StaticResource InputTextBoxStyle}" 
                             Padding="8,5" Height="34" Margin="0,0,0,15"/>

                    <!-- Кнопка реєстрації -->
                    <Button Content="Зареєструватися" Style="{StaticResource PrimaryButtonStyle}" 
                            Background="#10B981" Padding="0,8" FontWeight="Bold" FontSize="14" 
                            Margin="0,5,0,0" Click="BtnRegisterConfirm_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>