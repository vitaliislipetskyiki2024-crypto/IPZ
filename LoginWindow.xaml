<Window x:Class="CarServiceApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація — Автосервіс" Height="460" Width="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <!-- Центральна біла картка авторизації -->
        <Border Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Padding="25">
            <StackPanel VerticalAlignment="Center">

                <!-- Іконка та заголовок -->
                <TextBlock Text="🚘" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Вхід до системи" FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Поле вводу логіну -->
                <TextBlock Text="Логін:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtLogin" Style="{StaticResource InputTextBoxStyle}" 
                         Padding="8,5" Height="34" Margin="0,0,0,12" Text=""/>

                <!-- Поле вводу паролю -->
                <TextBlock Text="Пароль:" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <PasswordBox x:Name="TxtPassword" Height="34" Padding="8,5" 
                             Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                <!-- Кнопки дій -->
                <Button Content="Увійти" Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="0,8" FontWeight="Bold" FontSize="14" 
                        Margin="0,0,0,10" Click="BtnLogin_Click"/>

                <Button Content="Створити акаунт" Style="{StaticResource PrimaryButtonStyle}" 
                        Background="#64748B" Padding="0,8" FontWeight="SemiBold" 
                        Click="BtnRegister_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>