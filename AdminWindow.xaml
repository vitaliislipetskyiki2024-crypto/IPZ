<Window x:Class="CarServiceApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель Адміністратора СТО" Height="620" Width="920"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Сучасна темна шапка -->
        <Border Grid.Row="0" Background="#1E293B" Padding="15,12" CornerRadius="8" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Панель Адміністратора СТО" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Вийти" Style="{StaticResource PrimaryButtonStyle}" 
                        Background="#EF4444" Foreground="White" Width="67" Height="32" 
                        Click="BtnLogout_Click" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,10,-500,0"/>
            </DockPanel>
        </Border>

        <!-- Вкладки керування -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ВКЛАДКА 1: Керування заявками -->
            <TabItem Header="📋 Заявки клієнтів" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Картка з таблицею заявок -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="5" Margin="0,0,0,12">
                        <DataGrid x:Name="DgAdminOrders" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="36" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Клієнт" Binding="{Binding ClientName}" Width="130"/>
                                <DataGridTextColumn Header="Авто" Binding="{Binding CarModel}" Width="110"/>
                                <DataGridTextColumn Header="Номер" Binding="{Binding CarNumber}" Width="100"/>
                                <DataGridTextColumn Header="Послуга" Binding="{Binding ServiceType}" Width="*"/>
                                <DataGridTextColumn Header="Вартість (грн)" Binding="{Binding Price}" Width="100"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Кнопки дій -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
                        <Button Content="🔄 Оновити статус" Style="{StaticResource PrimaryButtonStyle}" 
                                Width="160" Height="38" Click="BtnUpdateStatus_Click" Margin="0,0,10,0"/>
                        <Button Content="🧾 Сформувати рахунок" Style="{StaticResource PrimaryButtonStyle}" 
                                Background="#10B981" Width="180" Height="38" Click="BtnGenerateInvoice_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: Керування каталогом послуг -->
            <TabItem Header="🛠️ Каталог послуг" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ліва картка: Таблиця послуг -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Послуги в базі даних" FontSize="15" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10" Grid.Row="0"/>

                            <DataGrid x:Name="DgServicesAdmin" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      RowHeight="34" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="95"/>
                                    <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding Price}" Width="80"/>
                                    <DataGridTextColumn Header="Час" Binding="{Binding Duration}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Права картка: Форма додавання -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="➕ Додати нову послугу" FontSize="15" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>

                                <TextBlock Text="Назва послуги:" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtServiceName" Margin="0,3,0,10" Padding="6,5" BorderBrush="#CBD5E1"/>

                                <TextBlock Text="Категорія:" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtCategory" Margin="0,3,0,10" Padding="6,5" BorderBrush="#CBD5E1"/>

                                <TextBlock Text="Вартість (грн):" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPrice" Margin="0,3,0,10" Padding="6,5" BorderBrush="#CBD5E1"/>

                                <TextBlock Text="Опис послуги:" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtDescription" Margin="0,3,0,10" Padding="6,5" Height="45" 
                                         TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1"/>

                                <TextBlock Text="Час (напр. 1.5 год):" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtDuration" Margin="0,3,0,15" Padding="6,5" BorderBrush="#CBD5E1"/>

                                <Button Content="Зберегти послугу" Style="{StaticResource PrimaryButtonStyle}" 
                                        Background="#10B981" Height="38" FontWeight="Bold" Click="BtnAddService_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>